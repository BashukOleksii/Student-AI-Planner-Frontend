{
  "name": "student-planner-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build-only && playwright test",
    "format": "prettier --write src tests e2e docs *.ts *.json README.md .github",
    "test:live": "npm run build-only && playwright test --config playwright.live.config.ts",
    "test:live:ai": "npm run build-only && playwright test --config playwright.ai-live.config.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
